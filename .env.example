# ==============================================================================
# VoxFlow Audio Studio - Unified Environment Variables Template
# Copy this file to .env for containerized or local full-stack execution.
# NEVER commit .env containing real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Environment Configuration
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://postgres:5432/tts_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_CONNECT_TIMEOUT_MS=30000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://tts.voxflow.com,https://app.voxflow.com

# JWT Authentication
JWT_SECRET=your_super_secret_256_bit_jwt_signing_key_at_least_64_characters_long
JWT_EXPIRATION_MS=86400000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=30
RATE_LIMIT_BURST=10

# Text-to-Speech (TTS) Provider Configuration
# Set TTS_PROVIDER=MOCK for offline testing; AZURE for Microsoft Cognitive Services
TTS_PROVIDER=MOCK
TTS_API_KEY=your_tts_provider_api_key_here
TTS_REGION=eastus
TTS_ENDPOINT=https://eastus.tts.speech.microsoft.com/cognitiveservices/v1
TTS_CONNECT_TIMEOUT_MS=5000
TTS_READ_TIMEOUT_MS=10000

# AI Text Enhancement Configuration
# Set AI_PROVIDER=MOCK for offline testing; OPENAI for OpenAI Chat API
AI_PROVIDER=MOCK
AI_API_KEY=your_ai_api_key_here
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=12000

# ------------------------------------------------------------------------------
# 2. Frontend Environment Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.voxflow.com
