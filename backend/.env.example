# ==============================================================================
# VoxFlow Backend - Environment Variables Template
# Copy this file to .env for local runtime or configure in your deployment orchestrator.
# NEVER commit .env containing real credentials or secrets to version control.
# ==============================================================================

# Active Spring Profile (options: 'dev' or 'prod')
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
# Required in production; dev defaults to jdbc:postgresql://localhost:5432/tts_db
DB_URL=jdbc:postgresql://localhost:5432/tts_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_CONNECT_TIMEOUT_MS=30000

# CORS Allowed Origins
# In production, set to your frontend domain (e.g., https://tts.voxflow.com,https://app.voxflow.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Authentication
# In production, provide a strong 256-bit (64-character hex or base64) secret
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=30
RATE_LIMIT_BURST=10

# Text-to-Speech (TTS) Provider Configuration
# Set TTS_PROVIDER=MOCK for local development without credentials
# Set TTS_PROVIDER=AZURE or EXTERNAL when supplying cloud speech provider credentials
TTS_PROVIDER=MOCK
TTS_API_KEY=your_tts_provider_api_key_here
TTS_REGION=eastus
TTS_ENDPOINT=https://eastus.tts.speech.microsoft.com/cognitiveservices/v1
TTS_CONNECT_TIMEOUT_MS=5000
TTS_READ_TIMEOUT_MS=10000

# AI Text Enhancement Provider Configuration
# Set AI_PROVIDER=MOCK for local development without credentials
# Set AI_PROVIDER=OPENAI or EXTERNAL when supplying cloud LLM credentials
AI_PROVIDER=MOCK
AI_API_KEY=your_ai_api_key_here
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=12000
