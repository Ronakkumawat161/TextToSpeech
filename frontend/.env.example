# ==============================================================================
# VoxFlow Frontend - Environment Variables Template
# Copy this file to .env.local for local overrides.
# In production, configure VITE_API_BASE_URL during the build process.
# ==============================================================================

# Backend API Base URL
# Development: http://localhost:8080
# Production: https://api.yourdomain.com (Do not include trailing slash)
VITE_API_BASE_URL=http://localhost:8080
